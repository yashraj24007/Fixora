# Supabase Configuration
# Get these values from https://app.supabase.com/ > Your Project > Settings > API

VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Example:
# VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AI Assistant API Configuration
# Configure these to enable AI-powered responses with Groq

# Groq API Endpoint
VITE_AI_API_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# Your Groq API Key (Get it from https://console.groq.com/)
VITE_AI_API_KEY=your_groq_api_key_here

# Groq Model to use (recommended: llama-3.1-70b-versatile, mixtral-8x7b-32768, or llama-3.1-8b-instant)
VITE_AI_MODEL=llama-3.1-70b-versatile

# Optional: Other AI settings
# VITE_AI_MAX_TOKENS=2000
# VITE_AI_TEMPERATURE=0.7
