'# Supabase Configuration
# Get these values from https://app.supabase.com/ > Your Project > Settings > API

VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Example:
# VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AI Assistant API Configuration
# Configure these to enable AI-powered responses with Groq

# Backend Server Configuration
VITE_BACKEND_URL=http://localhost:3001/api/chat

# Server-side API Keys (DO NOT prefix with VITE_ - these are backend-only)
# Your Groq API Key (Get it from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face API Key for embeddings (Get from https://huggingface.co/settings/tokens)
# FREE! No credit card required - 30,000 requests/month
HUGGINGFACE_API_KEY=hf_your_token_here

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:8080

# Optional: Other AI settings
# VITE_AI_MAX_TOKENS=2000
# VITE_AI_TEMPERATURE=0.7
