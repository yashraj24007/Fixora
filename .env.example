# ==========================================
# FIXORA - Environment Configuration Template
# ==========================================
# 📋 Copy this file to .env and fill in your actual values
# ⚠️ NEVER commit .env to Git - it contains secrets!

# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
# Get these values from https://app.supabase.com/ > Your Project > Settings > API

VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Example:
# VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==========================================
# GROQ AI CONFIGURATION (REQUIRED)
# ==========================================
# Get your FREE API key from: https://console.groq.com/

# Frontend AI API Keys (prefixed with VITE_ for Vite access)
VITE_AI_API_KEY=your_groq_api_key_here
VITE_AI_MODEL=llama-3.1-70b-versatile
VITE_AI_API_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# Backend Groq API Key (server-side calls)
GROQ_API_KEY=your_groq_api_key_here

# ==========================================
# HUGGING FACE CONFIGURATION
# ==========================================
# Get your FREE API key from: https://huggingface.co/settings/tokens
# FREE! No credit card required - 30,000 requests/month

HUGGINGFACE_API_KEY=hf_your_token_here

# ==========================================
# BACKEND SERVER CONFIGURATION
# ==========================================
VITE_BACKEND_URL=http://localhost:3001/api/chat

# Backend server port (used by server/index.ts)
PORT=3001
FRONTEND_URL=http://localhost:8080

# ==========================================
# OPTIONAL SETTINGS
# ==========================================
# VITE_AI_MAX_TOKENS=2000
# VITE_AI_TEMPERATURE=0.7

# ==========================================
# SETUP INSTRUCTIONS
# ==========================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your API keys above
# 3. Save the .env file
# 4. Restart your dev server: npm run dev
#
# 🔒 The .env file is already in .gitignore and will NOT be committed
